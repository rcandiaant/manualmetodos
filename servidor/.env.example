# Copiar a .env (ignorado por git). Valores de desarrollo con Docker.
BD_HOST=bd
BD_NOMBRE=manual
BD_NOMBRE_PRUEBAS=manual_pruebas
BD_USUARIO=manual
BD_CLAVE=manual_dev
# Producción: BD_DSN completo (si se define, tiene prioridad sobre BD_HOST/BD_NOMBRE).
# BD_DSN=mysql:host=localhost;dbname=...;charset=utf8mb4
# 32 bytes aleatorios en base64: php -r "echo base64_encode(random_bytes(32));"
CLAVE_CIFRADO=
CLAVE_INDICE=
# 1 en producción (HTTPS): cookie Secure y HSTS.
COOKIE_SEGURA=0
ZONA_HORARIA=America/Santiago
