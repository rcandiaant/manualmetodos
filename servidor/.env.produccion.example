# Plantilla del .env de PRODUCCIÓN. Copiarla como .env en la carpeta padre de la raíz web
# (al lado de vendor/, fuera de public/) y reemplazar cada <…>. El .env real no viaja en el paquete
# ni se versiona. Checklist completo: docs/api.md §6.
#
# Host de la base; en producción manda BD_DSN (tiene prioridad), docs/api.md §6 «Base de datos».
BD_HOST=<host-de-la-base, normalmente localhost; lo ignora BD_DSN>
# Base de la app en cPanel (Bases de datos MySQL), docs/api.md §6 «Base de datos».
BD_NOMBRE=<usuario-cpanel>_<base>
# Solo la usan las pruebas (phpunit); en producción no se usa, docs/api.md §6 «Paquete de producción».
BD_NOMBRE_PRUEBAS=<no-se-usa-en-produccion>
# Usuario con SOLO SELECT, INSERT, UPDATE y DELETE, docs/api.md §6 «Usuario de la base con privilegios mínimos».
BD_USUARIO=<usuario-cpanel>_<usuario-app>
# Clave de ese usuario (la genera cPanel), docs/api.md §6 «Usuario de la base con privilegios mínimos».
BD_CLAVE=<clave-del-usuario-de-la-base>
# DSN con charset=utf8mb4 (MariaDB 10.6, latin1 por defecto), docs/api.md §6 «Base de datos».
BD_DSN=mysql:host=localhost;dbname=<usuario-cpanel>_<base>;charset=utf8mb4
# 32 bytes aleatorios en base64, distinta de CLAVE_INDICE y respaldada fuera del servidor, docs/api.md §6 «Claves».
CLAVE_CIFRADO=<base64-de-32-bytes: openssl rand -base64 32>
# 32 bytes aleatorios en base64, distinta de CLAVE_CIFRADO y respaldada fuera del servidor, docs/api.md §6 «Claves».
CLAVE_INDICE=<base64-de-32-bytes-distinta: openssl rand -base64 32>
# Obligatorio en producción (falla abierto: sin él no hay cookie Secure/__Host- ni HSTS), docs/api.md §6 «COOKIE_SEGURA=1».
COOKIE_SEGURA=1
# Solo afecta a PHP; la base y la API trabajan en UTC, docs/api.md §6 «Zona horaria».
ZONA_HORARIA=America/Santiago
